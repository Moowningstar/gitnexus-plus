{
  "name": "dsh-gitnexus-plus",
  "version": "0.1.7",
  "description": "DSH plugin: visualize a GitNexus project index and its communities, decide whether a refresh would change anything before running it, search symbols by keyword, report what the index left out, and run incremental or FTS-repair maintenance from a sidebar panel.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moowningstar/gitnexus-plus.git"
  },
  "homepage": "https://github.com/Moowningstar/gitnexus-plus#readme",
  "bugs": {
    "url": "https://github.com/Moowningstar/gitnexus-plus/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "gitnexus",
    "code-index",
    "code-graph",
    "coverage"
  ],
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-gitnexus-coverage": "./lib/bin/gitnexus-coverage.js"
  },
  "files": [
    "lib",
    "scripts/link-runtime.mjs",
    "cordis.patch.yml",
    "README.md",
    "README-CN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.host.json && node scripts/build-client.mjs",
    "prepare": "npm run build",
    "postinstall": "node scripts/link-runtime.mjs",
    "check": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json && tsc -p tsconfig.client.json",
    "coverage": "node lib/bin/gitnexus-coverage.js",
    "test": "npm run build && node test/run.mjs && node test/plugin.mjs && node test/client.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.0.0 <4.0.0",
    "gitnexus": ">=1.6.0 <2.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "gitnexus": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-tools": "^0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
