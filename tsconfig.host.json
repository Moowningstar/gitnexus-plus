{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "outDir": "lib",
    "rootDir": "src",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts"],
  "exclude": ["src/client/**"]
}
